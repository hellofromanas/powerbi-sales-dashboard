// =====================================================================================
// DAX measures for the Sales Dashboard
// Tables: fact_sales, dim_product, dim_customer, dim_date  (see ../docs/data_model.md)
// Create these in a dedicated empty table named "_Measures" (Home > Enter data) to keep the model tidy.
// Cross-check every headline number against `python validate.py`.
// =====================================================================================

// ---------- Base measures ----------
Total Sales =
SUMX (
    fact_sales,
    fact_sales[quantity] * fact_sales[unit_price] * ( 1 - fact_sales[discount_pct] )
)

Total Cost =
SUMX (
    fact_sales,
    fact_sales[quantity] * RELATED ( dim_product[unit_cost] )
)

Total Profit = [Total Sales] - [Total Cost]

Profit Margin % = DIVIDE ( [Total Profit], [Total Sales] )

Orders = DISTINCTCOUNT ( fact_sales[order_id] )

Units Sold = SUM ( fact_sales[quantity] )

Average Order Value = DIVIDE ( [Total Sales], [Orders] )

Customers = DISTINCTCOUNT ( fact_sales[customer_id] )

// ---------- Time intelligence (requires dim_date marked as a date table) ----------
Sales PY = CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( dim_date[Date] ) )

Sales YoY % = DIVIDE ( [Total Sales] - [Sales PY], [Sales PY] )

Sales YTD = TOTALYTD ( [Total Sales], dim_date[Date] )

Sales MTD = TOTALMTD ( [Total Sales], dim_date[Date] )

Sales Rolling 3M =
CALCULATE (
    [Total Sales],
    DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -3, MONTH )
)

// ---------- Ranking / share ----------
Sales % of Total =
DIVIDE ( [Total Sales], CALCULATE ( [Total Sales], ALL ( dim_product ) ) )

Category Rank =
RANKX ( ALL ( dim_product[category] ), [Total Sales], , DESC, DENSE )

Top Product =
VAR _t = TOPN ( 1, ALL ( dim_product[product_name] ), [Total Sales], DESC )
RETURN
    MAXX ( _t, dim_product[product_name] )

// ---------- Discount analysis ----------
Discounted Order Share =
DIVIDE (
    CALCULATE ( [Orders], fact_sales[discount_pct] > 0 ),
    [Orders]
)

Discount Given =
SUMX (
    fact_sales,
    fact_sales[quantity] * fact_sales[unit_price] * fact_sales[discount_pct]
)

// ---------- Dynamic title (use on a card/title via conditional formatting) ----------
Sales Title =
"Sales for " &
IF ( ISFILTERED ( dim_date[Year] ), SELECTEDVALUE ( dim_date[Year], "selected years" ), "all years" )

// ---------- Calculated table: dim_date (Modeling > New table) ----------
// After creating it: Table tools > Mark as date table > choose [Date].
dim_date =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2024, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Quarter", "Q" & QUARTER ( [Date] ),
    "Month No", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMM" ),
    "Year-Month", FORMAT ( [Date], "YYYY-MM" )
)
// Tip: set Month to "Sort by column" = Month No so months sort Jan..Dec instead of alphabetically.
